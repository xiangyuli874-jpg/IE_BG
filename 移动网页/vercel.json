{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/export.ts": {
      "includeFiles": "outputs/worktime_new_template/工时测量与负荷山积自动扩展模板_v16.xlsx",
      "maxDuration": 60
    }
  }
}
